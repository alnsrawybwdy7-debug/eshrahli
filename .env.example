# انسخ هذا الملف باسم .env وعبّي القيم

# مفتاح سري طويل وعشوائي (ولّده بـ: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# حساب الأدمن (ينسوّى تلقائياً أول تشغيل)
ADMIN_USERNAME=abdullah
ADMIN_PASSWORD=
ADMIN_NAME=فاطمة ثائر

# اسم المنصة ومعلومات التواصل اللي تطلع للطالب بصفحة الاشتراك
SITE_NAME=اشرحلي
ADMIN_NAME=فاطمة ثائر
TEACHER_LABEL=المدرّسة
CONTACT_TELEGRAM=nomiya_0
CONTACT_WHATSAPP=

# قاعدة البيانات: فارغ = SQLite محلي (instance/data.db)
# لـ Neon: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# الطالب إذا سجل دخول من جهاز ثاني يطلع من الأول (ضد مشاركة الحساب)
SINGLE_DEVICE=1

# Cloudflare R2 — إذا فارغة، الملفات تنخزن محلياً بـ instance/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# صلاحية رابط الفيديو بالثواني
MEDIA_URL_TTL=10800

# LiveKit للاتصال المباشر (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# الطلاب يكدرون يشغلون مايك/كاميرا؟ (0 = بس يسمعون ويكتبون بالدردشة)
LIVE_STUDENTS_CAN_PUBLISH=1

# بالإنتاج على HTTPS خليها 1
COOKIE_SECURE=0
# إذا السيرفر ورا proxy (Render, Koyeb, Nginx) خليها 1
TRUST_PROXY=0
